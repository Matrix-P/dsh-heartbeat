{
  "name": "dsh-heartbeat",
  "version": "0.1.1",
  "description": "DSH 心跳：按时间规则向指定会话的主 Agent 主动投递一条你自己写的提示；模型输出期间不计时",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Matrix-P/dsh-heartbeat.git"
  },
  "homepage": "https://github.com/Matrix-P/dsh-heartbeat#readme",
  "bugs": {
    "url": "https://github.com/Matrix-P/dsh-heartbeat/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis",
    "heartbeat",
    "scheduler",
    "reminder",
    "timer",
    "cron"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "vitest run --pool=threads",
    "test:watch": "vitest --pool=threads",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"const fs=require('node:fs');for(const d of ['lib','build-client'])fs.rmSync(d,{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && pnpm run build:client",
    "build:client": "tsc -p tsconfig.build.client.json && node scripts/build-client.mjs",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm test"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.4",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.5-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.1.5-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-timer": "1.1.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
